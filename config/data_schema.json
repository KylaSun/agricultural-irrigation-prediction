    "soil_temperature_7-18cm": {"type": "number", "unit": "degC", "nullable": true, "range": [-30, 70], "meaning": "C3 保留历史列名；历史实际 band 为 7–28 cm，在线来源待确认"},
    "ec": {"type": "number", "unit": "uS/cm", "nullable": true, "range": [0, 1000], "meaning": "C3 现场土壤 EC；本轮硬件未采购"},
    "ph": {"type": "number", "unit": "pH", "nullable": true, "range": [3, 9], "meaning": "C3 现场土壤 pH；本轮硬件未采购"},
    "water_vol_past_4h": {"type": "number", "unit": "L", "nullable": true, "range": [0, 1000000], "meaning": "C3 过去4小时用水量；需由灌溉日志与流量口径构建，当前不可用"},
    "simulated": {"type": "boolean", "unit": "boolean", "nullable": false, "range": null, "meaning": "是否为明确标注的模拟数据"},
    "mode": {"type": "string", "unit": null, "nullable": false, "range": ["c1_soil_only", "c2_low_cost_hybrid", "c3_sensor_rich", "weather_only"], "meaning": "C1/C2/C3 研究配置或额外 weather-only 基线"},
    "quality_flag": {"type": "string", "unit": null, "nullable": false, "range": ["valid", "simulated", "missing", "out_of_range", "stale", "invalid"], "meaning": "记录级最严重质量状态"},
    "quality_detail": {"type": "string", "unit": null, "nullable": true, "range": null, "meaning": "分号分隔的可读质量说明"}
  }
