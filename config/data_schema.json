    "soil_3_status": {"type": "string", "unit": null, "nullable": false, "range": ["ok", "simulated", "disabled", "timeout", "read_error", "out_of_range", "stale"], "meaning": "soil_03 采集状态"},
    "soil_4_raw": {"type": "integer", "unit": "ADC count", "nullable": true, "range": [0, 4095], "meaning": "SEN0308 soil_04 原始 ADC"},
    "soil_4_moisture_pct": {"type": "number", "unit": "% relative", "nullable": true, "range": [0, 100], "meaning": "soil_04 独立校准后的相对湿度；不是通用体积含水率"},
